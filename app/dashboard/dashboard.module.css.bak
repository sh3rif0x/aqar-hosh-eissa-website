.wrapper {
  max-width: 1100px;
  margin: 0 auto;
  padding: 2rem 1rem;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
}

.header button {
  padding: 0.6rem 1.2rem;
  border: none;
  border-radius: 8px;
  background: #ef4444;
  color: #fff;
  cursor: pointer;
}
