{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/dashboard/monitor/[section]",
      "regex": "^/dashboard/monitor/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPsection": "nxtPsection"
      },
      "namedRegex": "^/dashboard/monitor/(?<nxtPsection>[^/]+?)(?:/)?$"
    },
    {
      "page": "/listing/[id]",
      "regex": "^/listing/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/listing/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/my-listings/edit/[id]",
      "regex": "^/my\\-listings/edit/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/my\\-listings/edit/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/profile/[id]",
